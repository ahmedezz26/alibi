# OpenRouter key for the judge model
OPENROUTER_API_KEY=
# OpenRouter model ID for the judge. Default is FREE; paid models are refused unless
# ALIBI_ALLOW_PAID_MODELS=1 (only with the user's explicit approval).
ALIBI_JUDGE_MODEL=deepseek/deepseek-v4-flash-0731:free
ALIBI_ALLOW_PAID_MODELS=0
# Judge thinking: off|low|medium|high, empty = model default ("off" is ~80x faster on DeepSeek)
ALIBI_JUDGE_REASONING=off
ALIBI_JUDGE_MAX_RETRIES=8
# Per-judge lengths (tokens): single call up to RELIABLE, else windows of WINDOW
ALIBI_JUDGE_RELIABLE_TOKENS=10000
ALIBI_JUDGE_WINDOW_TOKENS=10000
# LangSmith key for trace ingestion
LANGSMITH_API_KEY=
# Hugging Face token (gated datasets: microsoft/AgentRx, PatronusAI/TRAIL)
HF_TOKEN=
# TypeSafe (Jev), paid: needs ALIBI_ALLOW_PAID_MODELS=1 for approved runs only
TYPESAFE_API_KEY=
# openrouter (default) | typesafe
ALIBI_JUDGE_BACKEND=
# default jev-latest; runs record the concrete version returned (e.g. jev-1.13.0)
ALIBI_TYPESAFE_MODEL=
